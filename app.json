{
  "expo": {
    "name": "Rozkmina",
    "slug": "rozkmina",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#111214",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Rozkmina potrzebuje dostępu do zdjęć, żebyś mógł wybrać zdjęcie ścianki i zaznaczyć na nim chwyty.",
          "cameraPermission": "Rozkmina potrzebuje dostępu do aparatu, żebyś mógł zrobić zdjęcie ścianki.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
